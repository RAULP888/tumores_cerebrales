# Copia este archivo como ".env" y llena los valores. El archivo .env NO se sube a GitHub.

# ---------- Base de datos ----------
# local  = SQLite de respaldo en app/almacen/tumores.db (desarrollo y demostración sin internet)
# fabric = SQL database de Microsoft Fabric (motor SQL Server)
DB_MODO=local

# Solo para DB_MODO=fabric. Fabric acepta únicamente Microsoft Entra ID:
# al arrancar se abre una ventana para iniciar sesión con tu cuenta.
FABRIC_SERVIDOR=
FABRIC_BASE=
FABRIC_AUTENTICACION=ActiveDirectoryInteractive
FABRIC_USUARIO=

# ---------- Sesión ----------
# Minutos que dura una sesión iniciada.
SESION_MINUTOS=480
# true solo si la app se sirve por HTTPS.
COOKIE_SEGURA=false

# ---------- IA generativa (asistente de consultas) ----------
# Tu clave de la API de Claude. Nunca la compartas ni la subas al repositorio.
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-opus-5-5
# Máximo de filas que puede devolver una consulta del asistente.
ASISTENTE_LIMITE_FILAS=200

# ---------- Power BI ----------
# Liga publicada del tablero para mostrarlo dentro del panel del Administrador.
POWERBI_URL=
